# Application
APP_ENV=local
APP_NAME=case-management-platform
SYNTHETIC_ENVIRONMENT=1

# Database
DATABASE_URL=postgresql+asyncpg://cases:cases@localhost:5432/cases

# Document storage
DOCUMENTS_PATH=./documents

# CORS (frontend dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_DEV_USER=intake

# Tenant isolation defense-in-depth listener (opt-in, default true in local/prod)
TENANT_LISTENER_ENABLED=true

# Outbox dispatcher
OUTBOX_DISPATCHER_ENABLED=true
OUTBOX_DISPATCH_INTERVAL_SECONDS=5

# SLA scanner (local in-process scheduler; hosted worker is the Azure seam)
SLA_SCANNER_ENABLED=true
SLA_SCAN_INTERVAL_SECONDS=60

# Telemetry
TELEMETRY=structured
LOG_LEVEL=INFO


OPENROUTER_API_KEY=
